  "/instances/{id}/add_key": {
   "post": {
    "description": "Append an SSH public key to an existing instance's `authorized_keys`.\n\nBehavior:\n- If `public_key` is provided, that raw key material is appended to `authorized_keys`. If the same public key is already attached, the request is a no-op (no error).\n- If `public_key` is omitted, Thunder generates a new key pair, appends the public half to `authorized_keys`, and returns the private key in the response. The private key is only returned once \u2014 store it immediately.\n\nNote: SSH keys saved in your account (Authentication section of the console) are a separate store and are NOT automatically attached to instances. To use one of those keys, copy its public key material into the `public_key` field on this request.",
    "parameters": [
     {
      "description": "Instance ID",
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/thundertypes.InstanceAddKeyRequest",
        "description": "Optional: provide an existing public key to add",
        "summary": "request"
       }
      }
     },
     "description": "Optional: provide an existing public key to add"
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.InstanceAddKeyResponse"
        }
       }
      },
      "description": "OK"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Bad Request"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Unauthorized"
     },
     "404": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Not Found"
     },
     "500": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Internal Server Error"
     }
    },
    "security": [
     {
      "ApiKeyAuth": []
     }
    ],
    "summary": "Add SSH key to instance",
    "tags": [
     "Instances"
    ]
   }
  },
