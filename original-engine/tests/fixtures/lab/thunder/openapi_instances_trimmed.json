     "ramCapGiB": {
      "description": "RamCapGiB, when > 0, caps total RAM at the max vCPU option and makes RAM\naffine rather than a clean multiple of vCPU: RAM shrinks by RamPerVCPUGiB\nfor every vCPU below the max. Used for configs whose physical machine RAM\nis less than maxVcpu * RamPerVCPUGiB (e.g. multi-GPU A100). Zero/unset =\nproportional RAM = vcpu * RamPerVCPUGiB.",
      "type": "integer"
     },
     "ramPerVCPUGiB": {
      "type": "integer"
     },
