  "title": "Thunder Compute API",
  "version": "1.0"
 },
 "paths": {
  "/instances/create": {
   "post": {
    "description": "Create a new compute instance.\nThe optional mode field is retained for legacy compatibility. Its value does not select execution mode; routing is derived from num_gpus. New integrations should omit mode and use GET /v2/specs for available configurations.\n\nSSH access: pass an SSH public key in the `public_key` field to seed the instance's `authorized_keys`. If omitted, Thunder generates a key pair and returns the private key in the response (it is only returned once \u2014 store it immediately).\n\nNote: SSH keys saved in your account (Authentication section of the console) are a separate store and are NOT automatically attached to new instances. To use one of those keys, copy its public key material into the `public_key` field on this request.",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/thundertypes.InstanceCreateRequest",
        "description": "Instance creation parameters",
        "summary": "request"
       }
      }
     },
     "description": "Instance creation parameters",
     "required": true
    },
    "responses": {
     "201": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.InstanceCreateResponse"
        }
       }
      },
      "description": "Created"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Bad Request"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Unauthorized"
     },
     "500": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/thundertypes.ErrorResponse"
        }
       }
      },
      "description": "Internal Server Error"
     }
    },
    "security": [
     {
      "ApiKeyAuth": []
     }
    ],
    "summary": "Create instance",
    "tags": [
     "Instances"
    ]
   }
  },
